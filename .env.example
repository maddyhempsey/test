# Meta Ads API konfiguration
# Kopiér denne fil til .env og udfyld med dine egne værdier.

# Adgangstoken fra Meta Business Suite
# Hent den fra: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=dit_access_token_her

# Annoncekonto-ID (findes i Meta Business Suite under Indstillinger)
# Kan angives med eller uden "act_" prefix
META_AD_ACCOUNT_ID=act_123456789

# (Valgfrit) App credentials til langtidstoken
META_APP_ID=din_app_id
META_APP_SECRET=din_app_secret
